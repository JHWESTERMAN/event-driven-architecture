# Kopieer naar .env (staat in .gitignore) en pas aan. Alleen voor lokaal gebruik.
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis

# Bronapp: elke N milliseconden een willekeurige actie (0 = uit, alleen via HTTP bedienen)
BRON_AUTO_INTERVAL_MS=0

# Waar de bronapp zijn berichten naartoe stuurt. Standaard de source-adapter in Compose.
# Zet hem leeg om de bronapp droog te laten draaien (alleen bouwen en bewaren, niet versturen).
# ADAPTER_URL=http://source-adapter:8090/werkopdracht

# Eigen Artemis-gebruikers per adapter (minimale rechten). Alleen voor lokaal gebruik; kies eigen waarden.
SOURCE_ADAPTER_BROKER_USER=source-adapter
SOURCE_ADAPTER_BROKER_PASSWORD=source-adapter-dev
TARGET_ADAPTER_BROKER_USER=target-adapter
TARGET_ADAPTER_BROKER_PASSWORD=target-adapter-dev

# Geheim van het Keycloak-service-account van de target-adapter (client credentials). Alleen lokaal; kies een eigen waarde.
TARGET_ADAPTER_CLIENT_SECRET=target-adapter-dev-secret

# Optioneel, alleen om lokaal zonder Keycloak te testen: gedeelde sleutel voor PUT /intern (dan ook INTERN_API_KEY in de
# werkorder-api en de target-adapter zetten en OIDC_TOKEN_URL leeg laten). Normaal niet gebruiken.
# INTERN_API_KEY=dev-intern-sleutel
