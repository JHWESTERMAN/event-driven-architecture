# Kopieer naar .env (staat in .gitignore) en pas aan. Alleen voor lokaal gebruik.
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis

# Bronapp: elke N milliseconden een willekeurige actie (0 = uit, alleen via HTTP bedienen)
BRON_AUTO_INTERVAL_MS=0

# Waar de bronapp zijn berichten naartoe stuurt. Standaard de source-adapter in Compose.
# Zet hem leeg om de bronapp droog te laten draaien (alleen bouwen en bewaren, niet versturen).
# ADAPTER_URL=http://source-adapter:8090/werkopdracht

# Gedeelde sleutel tussen target-adapter en werkorder-api (PUT /intern/...). Alleen PoC; kies een eigen waarde.
INTERN_API_KEY=dev-intern-sleutel
