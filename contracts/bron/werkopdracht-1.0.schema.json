{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eam-poc:bron:werkopdracht:1.0",
  "title": "Werkopdracht (bron-interface van het onderhoudssysteem OMS)",
  "description": "De eigen, bewust afwijkende interface van de bronapp. Nederlandse veldnamen, codelijsten, lokale tijden zonder tijdzone, Rijksdriehoek-coordinaten, medewerkernummers van 6 cijfers. De source-adapter valideert hiertegen en vertaalt naar het canonieke EAM-model.",
  "type": "object",
  "required": ["kop", "opdracht"],
  "additionalProperties": false,
  "properties": {
    "kop": { "$ref": "#/$defs/kop" },
    "opdracht": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "type": "object", "required": ["kop"],
        "properties": {
          "kop": {
            "type": "object", "required": ["berichtSoort"],
            "properties": { "berichtSoort": { "enum": ["NIEUW", "WIJZIGING"] } }
          }
        }
      },
      "then": { "properties": { "opdracht": { "$ref": "#/$defs/opdrachtVolledig" } } },
      "else": { "properties": { "opdracht": { "$ref": "#/$defs/opdrachtIntrekking" } } }
    }
  ],
  "$defs": {
    "tijdstip": {
      "description": "Lokale tijd in Nederland (Europe/Amsterdam), zonder tijdzone-aanduiding: dd-MM-yyyy HH:mm:ss",
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{4} ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "opdrachtNr": {
      "type": "string",
      "pattern": "^WOP-[0-9]{6}$"
    },
    "kop": {
      "type": "object",
      "required": ["berichtId", "verzondenOp", "bronSysteem", "berichtSoort", "volgnummer"],
      "additionalProperties": false,
      "properties": {
        "berichtId": { "type": "string", "format": "uuid" },
        "verzondenOp": { "$ref": "#/$defs/tijdstip" },
        "bronSysteem": { "const": "OMS" },
        "berichtSoort": { "enum": ["NIEUW", "WIJZIGING", "INTREKKING"] },
        "volgnummer": {
          "description": "Versie van de opdracht: begint bij 1 en gaat bij elke wijziging omhoog",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "opdrachtIntrekking": {
      "type": "object",
      "required": ["opdrachtNr", "redenCode"],
      "additionalProperties": false,
      "properties": {
        "opdrachtNr": { "$ref": "#/$defs/opdrachtNr" },
        "redenCode": { "enum": ["DUBBEL", "FOUTIEF", "VERVALLEN", "OVERIG"] }
      }
    },
    "opdrachtVolledig": {
      "type": "object",
      "required": ["opdrachtNr", "soortCode", "prioriteitCode", "statusCode", "omschrijving", "object", "locatie"],
      "additionalProperties": false,
      "properties": {
        "opdrachtNr": { "$ref": "#/$defs/opdrachtNr" },
        "soortCode": { "description": "COR correctief, PRV preventief, INS inspectie", "enum": ["COR", "PRV", "INS"] },
        "prioriteitCode": { "description": "1 spoed ... 4 laag", "type": "integer", "minimum": 1, "maximum": 4 },
        "statusCode": { "description": "01 aangemaakt, 02 ingepland, 03 toegewezen, 04 in uitvoering, 05 gereed", "enum": ["01", "02", "03", "04", "05"] },
        "omschrijving": {
          "type": "object",
          "required": ["kort"],
          "additionalProperties": false,
          "properties": {
            "kort": { "type": "string", "minLength": 1, "maxLength": 120 },
            "lang": { "type": "string", "maxLength": 2000 }
          }
        },
        "object": {
          "type": "object",
          "required": ["objectNr", "functioneleLocatie"],
          "additionalProperties": false,
          "properties": {
            "objectNr": { "type": "string", "pattern": "^OBJ-[0-9]{5}$" },
            "functioneleLocatie": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$", "maxLength": 40 },
            "objectType": { "enum": ["WSL", "SEI", "OVW", "KAB", "PRT"] }
          }
        },
        "locatie": {
          "type": "object",
          "required": ["plaats"],
          "additionalProperties": false,
          "properties": {
            "plaats": { "type": "string", "minLength": 1, "maxLength": 80 },
            "emplacement": { "type": "string", "maxLength": 80 },
            "positie": {
              "description": "Of Rijksdriehoek (rd), of WGS84 (wgs84): precies een van de twee",
              "oneOf": [
                {
                  "type": "object",
                  "required": ["rd"],
                  "additionalProperties": false,
                  "properties": {
                    "rd": {
                      "type": "object",
                      "required": ["x", "y"],
                      "additionalProperties": false,
                      "properties": {
                        "x": { "type": "number", "minimum": 0, "maximum": 300000 },
                        "y": { "type": "number", "minimum": 289000, "maximum": 629000 }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["wgs84"],
                  "additionalProperties": false,
                  "properties": {
                    "wgs84": {
                      "type": "object",
                      "required": ["breedte", "lengte"],
                      "additionalProperties": false,
                      "properties": {
                        "breedte": { "type": "number", "minimum": 50, "maximum": 54 },
                        "lengte": { "type": "number", "minimum": 3, "maximum": 8 }
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "toewijzing": {
          "type": "object",
          "required": ["medewerkerNr", "naam"],
          "additionalProperties": false,
          "properties": {
            "medewerkerNr": { "type": "string", "pattern": "^[0-9]{6}$" },
            "naam": {
              "type": "object",
              "required": ["voornaam", "achternaam"],
              "additionalProperties": false,
              "properties": {
                "voornaam": { "type": "string", "minLength": 1 },
                "tussenvoegsel": { "type": "string" },
                "achternaam": { "type": "string", "minLength": 1 }
              }
            },
            "ploeg": { "type": "string", "maxLength": 40 }
          }
        },
        "planning": {
          "type": "object",
          "required": ["geplandStart", "geplandEinde"],
          "additionalProperties": false,
          "properties": {
            "geplandStart": { "$ref": "#/$defs/tijdstip" },
            "geplandEinde": { "$ref": "#/$defs/tijdstip" }
          }
        },
        "werkpakket": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["stapNr", "omschrijving", "gereed"],
            "additionalProperties": false,
            "properties": {
              "stapNr": { "type": "integer", "minimum": 10, "multipleOf": 10 },
              "omschrijving": { "type": "string", "minLength": 1, "maxLength": 200 },
              "gereed": { "description": "J of N", "enum": ["J", "N"] }
            }
          }
        },
        "materialen": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["artikelCode", "omschrijving", "hoeveelheid"],
            "additionalProperties": false,
            "properties": {
              "artikelCode": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{3}$" },
              "omschrijving": { "type": "string", "minLength": 1, "maxLength": 200 },
              "hoeveelheid": {
                "type": "object",
                "required": ["waarde", "eenheid"],
                "additionalProperties": false,
                "properties": {
                  "waarde": { "type": "number", "exclusiveMinimum": 0 },
                  "eenheid": { "description": "ST stuks, M meter, KG kilogram", "enum": ["ST", "M", "KG"] }
                }
              }
            }
          }
        }
      },
      "if": {
        "type": "object", "required": ["statusCode"],
        "properties": { "statusCode": { "enum": ["03", "04", "05"] } }
      },
      "then": { "required": ["toewijzing"], "properties": { "toewijzing": true } }
    }
  }
}
